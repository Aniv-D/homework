"""
EDITH ORB - a glowing circle that floats on top of every app.

    Drag ............ move it anywhere
    Click ........... talk to EDITH (it listens once, then runs your command)
    Double-click .... shrink / grow
    Right-click ..... menu: type a command, wake word, quit

Run it on its own:  python edith_orb.py     (keep it in the same folder as edith.py)
It also starts automatically when you run edith.py.
"""
import math, platform, random, threading, tkinter as tk
from tkinter import simpledialog

from edith import handle, FLAGS, LOG, sr

OS = platform.system()
KEY = "#010203"                      # colour that becomes see-through
S = 190                              # orb size
state = {"listening": False, "wake": False, "mini": False, "label": "EDITH", "t": 0.0}

root = tk.Tk()
root.overrideredirect(True)
root.attributes("-topmost", True)
root.configure(bg=KEY)
bg = KEY
try:
    if OS == "Windows": root.attributes("-transparentcolor", KEY)
    elif OS == "Darwin": root.attributes("-transparent", True); root.configure(bg="systemTransparent"); bg = "systemTransparent"
    else: root.attributes("-alpha", 0.92)
except tk.TclError:
    pass
cv = tk.Canvas(root, width=S, height=S + 26, bg=bg, highlightthickness=0)
cv.pack()
root.geometry(f"+{root.winfo_screenwidth() - S - 40}+60")


def mix(c1, c2, f):
    a = [int(c1[i:i + 2], 16) for i in (1, 3, 5)]; b = [int(c2[i:i + 2], 16) for i in (1, 3, 5)]
    return "#%02x%02x%02x" % tuple(int(a[i] + (b[i] - a[i]) * f) for i in range(3))


def draw():
    t = state["t"] = state["t"] + 0.05
    cv.delete("all")
    k = 0.55 if state["mini"] else 1.0
    cx, cy = S / 2, S / 2
    col = "#ffc83c" if state["listening"] else "#4cc8ff"
    pulse = 1 + 0.05 * math.sin(t * 3) + (0.08 * math.sin(t * 9) if state["listening"] else 0)
    R = 78 * k * pulse
    for i in range(7, 0, -1):                                   # soft glow
        r = R + i * 3 * k
        cv.create_oval(cx - r, cy - r, cx + r, cy + r, outline=mix("#050a14", col, .09 * (8 - i)), width=3)
    cv.create_oval(cx - R, cy - R, cx + R, cy + R, fill="#06101c", outline=col, width=2)
    for r, sp, w, n in ((R * .92, 60, 4, 3), (R * .76, -90, 3, 4), (R * .58, 140, 2, 6)):   # rotating rings
        for j in range(n):
            a = t * sp + j * 360 / n
            cv.create_arc(cx - r, cy - r, cx + r, cy + r, start=a, extent=360 / n * .55, style="arc", outline=col, width=w)
    ticks = 36
    for j in range(ticks):                                      # outer tick marks
        a = math.radians(j * 360 / ticks + t * 10)
        r1, r2 = R * .98, R * (1.06 if j % 3 == 0 else 1.02)
        cv.create_line(cx + r1 * math.cos(a), cy + r1 * math.sin(a), cx + r2 * math.cos(a), cy + r2 * math.sin(a), fill=mix("#06101c", col, .8))
    if random.random() < .55:                                   # lightning inside the orb
        a = random.uniform(0, 6.28); x, y = cx, cy; pts = [x, y]
        for s in range(1, 7):
            rr = R * .5 * s / 6; aa = a + random.uniform(-.35, .35)
            pts += [cx + rr * math.cos(aa), cy + rr * math.sin(aa)]
        cv.create_line(*pts, fill="#ffffff", width=2); cv.create_line(*pts, fill=col, width=4, stipple="gray50")
    cr = R * .2 * (1 + .15 * math.sin(t * 5))                   # core
    cv.create_oval(cx - cr, cy - cr, cx + cr, cy + cr, fill=col, outline="white", width=2)
    if not state["mini"]:
        cv.create_text(cx, cy + R + 14, text=state["label"][:26], fill=col, font=("Consolas", 10, "bold"))
    root.after(33, draw)


# ---- interaction -----------------------------------------------------------
drag = {"x": 0, "y": 0, "moved": False}


def press(e): drag.update(x=e.x, y=e.y, moved=False)


def motion(e):
    if abs(e.x - drag["x"]) + abs(e.y - drag["y"]) > 4: drag["moved"] = True
    root.geometry(f"+{root.winfo_x() + e.x - drag['x']}+{root.winfo_y() + e.y - drag['y']}")


def release(e):
    if not drag["moved"] and not state["listening"]: threading.Thread(target=listen_once, daemon=True).start()


def run_cmd(text):
    state["label"] = text
    try: handle(text)
    except Exception as ex: state["label"] = f"error: {ex}"
    if LOG: state["label"] = LOG[-1].lstrip("> ")


def listen_once(wake=False):
    if not sr: state["label"] = "pip install SpeechRecognition"; return
    state["listening"] = True; state["label"] = "listening..."
    try:
        r = sr.Recognizer()
        with sr.Microphone() as s:
            r.adjust_for_ambient_noise(s, .3); audio = r.listen(s, timeout=4, phrase_time_limit=6)
        text = r.recognize_google(audio).lower()
        if not wake or text.startswith(("edith", "hey edith")): run_cmd(text)
    except Exception:
        if not wake: state["label"] = "didn't catch that"
    state["listening"] = False


def wake_loop():
    while FLAGS["run"]:
        if state["wake"] and not state["listening"]: listen_once(wake=True)
        else: threading.Event().wait(.4)


def type_cmd():
    s = simpledialog.askstring("EDITH", "Command:", parent=root)
    if s: threading.Thread(target=run_cmd, args=(s,), daemon=True).start()


def toggle_mini(e=None): state["mini"] = not state["mini"]


def toggle_wake():
    state["wake"] = not state["wake"]; state["label"] = "wake word ON" if state["wake"] else "wake word OFF"


def quit_all(): FLAGS["run"] = False; root.destroy()


menu = tk.Menu(root, tearoff=0)
menu.add_command(label="Type a command...", command=type_cmd)
menu.add_command(label="Toggle wake word 'EDITH'", command=toggle_wake)
menu.add_command(label="Shrink / grow", command=toggle_mini)
menu.add_separator(); menu.add_command(label="Quit EDITH orb", command=quit_all)

cv.bind("<ButtonPress-1>", press); cv.bind("<B1-Motion>", motion); cv.bind("<ButtonRelease-1>", release)
cv.bind("<Double-Button-1>", toggle_mini)
cv.bind("<Button-3>", lambda e: menu.tk_popup(e.x_root, e.y_root)); cv.bind("<Button-2>", lambda e: menu.tk_popup(e.x_root, e.y_root))
root.after(500, lambda: root.lift())


def keep_on_top():
    root.attributes("-topmost", True); root.lift()
    if not FLAGS["run"]: root.destroy(); return
    root.after(1500, keep_on_top)


threading.Thread(target=wake_loop, daemon=True).start()
draw(); keep_on_top()
root.mainloop()